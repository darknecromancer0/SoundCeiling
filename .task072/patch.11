+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+BUILD="$ROOT/app/build.gradle.kts"
+WF="$ROOT/.github/workflows/build-apk.yml"
+README="$ROOT/README.md"
+CHECKLIST="$ROOT/docs/field-tests/2026-08-23-v0.7.2-samsung-corrective-checklist.md"
+fail(){ echo "v0.7.2 release contract: $*" >&2; exit 1; }
+require(){ local f="$1" n="$2"; [[ -f "$f" ]] || fail "missing $(basename "$f")"; grep -Fq -- "$n" "$f" || fail "missing $(basename "$f") -> $n"; }
+require_order(){ local f="$1" a="$2" b="$3" la lb; require "$f" "$a"; require "$f" "$b"; la=$(grep -Fn -- "$a" "$f"|head -1|cut -d: -f1); lb=$(grep -Fn -- "$b" "$f"|head -1|cut -d: -f1); [[ $la -lt $lb ]] || fail "expected order: $a before $b"; }
+
+require "$BUILD" 'versionCode=12'
+require "$BUILD" 'versionName="0.7.2"'
+require "$WF" 'run: bash ./scripts/check-v072-corrective-contract.sh'
+require "$WF" 'run: bash ./scripts/check-v072-release-contract.sh'
+require "$WF" 'name: SoundCeiling-v0.7.2-debug-apk'
+require "$WF" 'path: app/build/outputs/apk/debug/app-debug.apk'
+require_order "$WF" 'run: bash ./scripts/check-v071-release-contract.sh' 'run: bash ./scripts/check-v072-corrective-contract.sh'
+require_order "$WF" 'run: bash ./scripts/check-v072-corrective-contract.sh' 'run: bash ./scripts/check-v072-release-contract.sh'
+require_order "$WF" 'run: bash ./scripts/check-v072-release-contract.sh' 'run: ./gradlew --no-daemon --stacktrace :app:assembleDebug'
+require "$README" '# Sound Ceiling for Android - v0.7.2'
+require "$README" 'Samsung Media is the user anchor'
+require "$CHECKLIST" 'awaiting device test'
+require "$CHECKLIST" 'YouTube'
+require "$CHECKLIST" 'Yandex Music'
+require "$CHECKLIST" 'global_dsp_transport'
+require "$CHECKLIST" 'APK SHA-256'
+
+echo "v0.7.2 release contract: PASS"
