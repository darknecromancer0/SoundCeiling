diff --git a/app/src/main/java/dev/soundceiling/app/FallbackFloorPolicy.java b/app/src/main/java/dev/soundceiling/app/FallbackFloorPolicy.java
new file mode 100644
index 0000000..975cdda
--- /dev/null
+++ b/app/src/main/java/dev/soundceiling/app/FallbackFloorPolicy.java
@@ -0,0 +1,21 @@
+package dev.soundceiling.app;
+
+/** Ordinary Media fallback floor relative to the user's current master anchor. */
+final class FallbackFloorPolicy {
+    static final float DEFAULT_MAX_ATTENUATION_DB = 18f;
+
+    static int ordinaryFloor(ControlVolumeCurve curve, int userAnchorIndex,
+                             boolean explicitMinimum, int configuredMinimum) {
+        if (curve == null) return Math.max(0, configuredMinimum);
+        int configured = DbMath.clamp(configuredMinimum, curve.minIndex(), curve.maxIndex());
+        if (explicitMinimum) return configured;
+        int anchor = DbMath.clamp(userAnchorIndex, curve.minIndex(), curve.maxIndex());
+        float thresholdDb = curve.gainDbForIndex(anchor) - DEFAULT_MAX_ATTENUATION_DB;
+        for (int index = curve.minIndex(); index <= anchor; index++) {
+            if (curve.gainDbForIndex(index) >= thresholdDb) return index;
+        }
+        return curve.minIndex();
+    }
+
+    private FallbackFloorPolicy() {}
+}
diff --git a/app/src/main/java/dev/soundceiling/app/GlobalDspProbeDecision.java b/app/src/main/java/dev/soundceiling/app/GlobalDspProbeDecision.java
new file mode 100644
index 0000000..c8f9fbb
--- /dev/null
+++ b/app/src/main/java/dev/soundceiling/app/GlobalDspProbeDecision.java
@@ -0,0 +1,16 @@
+package dev.soundceiling.app;
+
+/** Chooses a real measurement source for the bounded Global DSP proof. */
+final class GlobalDspProbeDecision {
+    enum Meter { NONE, OUTPUT_MIX, PLAYBACK_PCM }
+
+    static Meter choose(boolean preferenceEnabled, boolean allowedMediaActive,
+                        boolean outputMixAvailable, boolean playbackPcmAvailable) {
+        if (!preferenceEnabled || !allowedMediaActive) return Meter.NONE;
+        if (outputMixAvailable) return Meter.OUTPUT_MIX;
+        if (playbackPcmAvailable) return Meter.PLAYBACK_PCM;
+        return Meter.NONE;
+    }
+
+    private GlobalDspProbeDecision() {}
+}
